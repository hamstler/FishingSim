; Engine configuration file.
config_version=5

[application]

config/name="Fishing Sim (RF4-like)"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.3", "C#")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="FishingSim"

[rendering]

environment/defaults/default_clear_color=Color(0.5, 0.7, 0.9, 1)
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=1
environment/ssil/quality=1

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=2
theme/default_font_subpixel_positioning=0

[shader_globals]

cloud_drift={
"type": "float",
"value": 0.0
}
