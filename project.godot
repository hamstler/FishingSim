; Engine configuration file.
config_version=5

[application]

config/name="Fishing Sim (RF4-like)"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.7", "C#")

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.5

[dotnet]

project/assembly_name="FishingSim"

[physics]

common/max_physics_steps_per_frame=4

[rendering]

environment/defaults/default_clear_color=Color(0.5, 0.7, 0.9, 1)
textures/default_filters/anisotropic_filtering_level=4
textures/default_filters/texture_mipmap_bias=-0.5
environment/ssao/quality=1
environment/ssil/quality=1

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1
theme/default_font_subpixel_positioning=1
theme/default_font_multichannel_signed_distance_field=false

[shader_globals]

cloud_drift={
"type": "float",
"value": 0.0
}
water_time={
"type": "float",
"value": 0.0
}
water_amp={
"type": "float",
"value": 0.03
}
water_dir={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
sun_dir={
"type": "vec3",
"value": Vector3(0, 1, 0)
}
daylight={
"type": "float",
"value": 1.0
}
sun_color={
"type": "color",
"value": Color(1, 0.97, 0.92, 1)
}
water_chop={
"type": "float",
"value": 1.4
}
foliage_wind={
"type": "float",
"value": 0.3
}
foliage_time={
"type": "float",
"value": 0.0
}
